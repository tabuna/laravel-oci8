includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - src

    level: max

    stubFiles:
        - stubs/IlluminateDatabase.stub

    ignoreErrors:
        # Eloquent models instantiate subclasses with their own constructors.
        -
            identifier: new.static
            path: src/Oci8/Eloquent/OracleEloquent.php
            count: 1

    noEnvCallsOutsideOfConfig: false
